# Placeholders only. Never commit .env.
# Create your .env with random secrets:  uv run python scripts/init_env.py
#   - every value "replace-me" is replaced with a random secret
#   - every value "set-me" is yours to fill in by hand
APP_ENV=development
APP_SECRET_KEY=replace-me
MCP_AUTH_SECRET=replace-me
MEMORY_TTL_DAYS=90
CHECKPOINT_TTL_DAYS=30

# --- Local stack (docker-compose.yml); all on 127.0.0.1 ---
# Use 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and each connection stalls.
# The password in DATABASE_URL is filled with POSTGRES_PASSWORD by init_env.py.
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+psycopg://devguard:replace-me@127.0.0.1:5432/devguard
# p7: least-privilege runtime roles, created by scripts/db_migrate.py. DATABASE_URL stays the owner role, used
# only for migrations and the audit purge. An existing .env gains these with: init_env.py --add-missing
DEVGUARD_APP_DB_PASSWORD=replace-me
DEVGUARD_TICKET_DB_PASSWORD=replace-me
DEVGUARD_AUDIT_DB_PASSWORD=replace-me
QDRANT_URL=http://127.0.0.1:6333

# Langfuse (self-hosted v4)
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_SECRET_KEY=replace-me
LANGFUSE_INIT_USER_EMAIL=admin@devguard.local
LANGFUSE_INIT_USER_PASSWORD=replace-me
LANGFUSE_DB_PASSWORD=replace-me
SALT=replace-me
ENCRYPTION_KEY=replace-me
NEXTAUTH_SECRET=replace-me
CLICKHOUSE_PASSWORD=replace-me
REDIS_AUTH=replace-me
MINIO_ROOT_PASSWORD=replace-me

# --- vLLM on RunPod, reached through the SSH tunnel (scripts/tunnel.sh) ---
# Copy VLLM_API_KEY into a RunPod secret named VLLM_API_KEY.
VLLM_BASE_URL=http://127.0.0.1:8080/v1
VLLM_API_KEY=replace-me
MODEL_ID=Qwen/Qwen3-8B-FP8
EMBEDDING_MODEL_ID=replace-with-embedding-model
RERANKER_MODEL_ID=replace-with-reranker-model

# From the pod's Connect tab, "SSH over exposed TCP". Changes for every new pod.
RUNPOD_SSH_HOST=set-me
RUNPOD_SSH_PORT=set-me
RUNPOD_SSH_KEY_PATH=~/.ssh/id_ed25519

# GPU the current pod got, as a short lowercase slug (e.g. rtx-a5000, rtx-pro-4000).
# Written into each health-check line so the control band compares like with like.
DEVGUARD_GPU_LABEL=

# p9: Langfuse alert webhook (docs/p9-demo-ui-alerts/runbook.md). Langfuse generates this secret when you create
# the webhook automation; paste it here by hand. Empty = the alert-receiver refuses to start.
LANGFUSE_ALERT_WEBHOOK_SECRET=
