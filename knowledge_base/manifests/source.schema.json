{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qris-devguard/source-manifest.schema.json",
  "title": "QRIS DevGuard source inventory",
  "type": "object",
  "required": [
    "manifest_version",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "title",
        "publisher",
        "kind",
        "source_url",
        "document_version",
        "effective_date",
        "language",
        "data_owner",
        "permission",
        "approval_status",
        "checksum_sha256"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "publisher": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "kind": {
          "enum": [
            "specification",
            "response_codes",
            "internal_sop",
            "fixture_set"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 500
        },
        "local_path": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$",
          "maxLength": 300
        },
        "document_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?$"
        },
        "language": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "id",
              "en"
            ]
          }
        },
        "data_owner": {
          "enum": [
            "kb_maintainer",
            "team_lead",
            "validator_owner",
            "platform_owner"
          ]
        },
        "permission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "evidence"
          ],
          "properties": {
            "basis": {
              "enum": [
                "unconfirmed",
                "reference_only",
                "public_terms",
                "written_permission",
                "team_authored"
              ]
            },
            "evidence": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 500
            }
          }
        },
        "approval_status": {
          "enum": [
            "candidate",
            "approved",
            "rejected",
            "superseded"
          ]
        },
        "superseded_by": {
          "type": "string"
        },
        "checksum_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    }
  }
}
