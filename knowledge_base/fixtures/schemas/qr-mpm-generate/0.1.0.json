{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qris-devguard:schema:qr-mpm-generate:0.1.0",
  "title": "qr-mpm-generate request (SYNTHETIC; from synthetic-qris-mpm-service-spec 0.1.0 sections 1.3 and 2)",
  "x-source": {"document_id": "synthetic-qris-mpm-service-spec", "document_version": "0.1.0", "section": "2. Generate QR"},
  "x-schema-version": "0.1.0",
  "x-synthetic": true,
  "type": "object",
  "required": ["headers", "body"],
  "additionalProperties": false,
  "properties": {
    "headers": {"$ref": "#/$defs/mpm_headers"},
    "body": {
      "type": "object",
      "required": ["partnerReferenceNo", "amount", "merchantId"],
      "additionalProperties": false,
      "properties": {
        "partnerReferenceNo": {"type": "string", "minLength": 1, "maxLength": 64},
        "amount": {
          "type": "object",
          "required": ["value", "currency"],
          "additionalProperties": false,
          "properties": {
            "value": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
            "currency": {"const": "IDR"}
          }
        },
        "merchantId": {"type": "string", "minLength": 1, "maxLength": 64},
        "terminalId": {"type": "string", "minLength": 1, "maxLength": 16},
        "validityPeriod": {"$ref": "#/$defs/mpm_timestamp"},
        "additionalInfo": {"type": "object"}
      }
    }
  },
  "$defs": {
    "mpm_timestamp": {
      "description": "yyyy-MM-ddTHH:mm:ss.SSS+HH:MM (section 1.3; numeric offset, no Z)",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}[+-][0-9]{2}:[0-9]{2}$"
    },
    "mpm_headers": {
      "type": "object",
      "required": ["Content-Type", "Authorization", "X-TIMESTAMP", "X-SIGNATURE", "X-PARTNER-ID", "X-EXTERNAL-ID", "CHANNEL-ID"],
      "properties": {
        "Content-Type": {"type": "string", "pattern": "^application/json(\\s*;\\s*charset=[Uu][Tt][Ff]-8)?$"},
        "Authorization": {"type": "string", "pattern": "^Bearer \\S+$"},
        "X-TIMESTAMP": {"$ref": "#/$defs/mpm_timestamp"},
        "X-SIGNATURE": {"type": "string", "minLength": 1},
        "X-PARTNER-ID": {"type": "string", "minLength": 1, "maxLength": 36},
        "X-EXTERNAL-ID": {"type": "string", "pattern": "^[0-9]{1,36}$"},
        "CHANNEL-ID": {"type": "string", "pattern": "^[0-9]{5}$"}
      },
      "additionalProperties": {"type": "string"}
    }
  }
}
