{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qris-devguard:schema:qr-mpm-query:0.1.0",
  "title": "qr-mpm-query request (SYNTHETIC; from synthetic-qris-mpm-service-spec 0.1.0 sections 1.3 and 3)",
  "x-source": {"document_id": "synthetic-qris-mpm-service-spec", "document_version": "0.1.0", "section": "3. Query Payment"},
  "x-schema-version": "0.1.0",
  "x-synthetic": true,
  "type": "object",
  "required": ["headers", "body"],
  "additionalProperties": false,
  "properties": {
    "headers": {
      "type": "object",
      "required": ["Content-Type", "Authorization", "X-TIMESTAMP", "X-SIGNATURE", "X-PARTNER-ID", "X-EXTERNAL-ID", "CHANNEL-ID"],
      "properties": {
        "Content-Type": {"type": "string", "pattern": "^application/json(\\s*;\\s*charset=[Uu][Tt][Ff]-8)?$"},
        "Authorization": {"type": "string", "pattern": "^Bearer \\S+$"},
        "X-TIMESTAMP": {"$ref": "#/$defs/mpm_timestamp"},
        "X-SIGNATURE": {"type": "string", "minLength": 1},
        "X-PARTNER-ID": {"type": "string", "minLength": 1, "maxLength": 36},
        "X-EXTERNAL-ID": {"type": "string", "pattern": "^[0-9]{1,36}$"},
        "CHANNEL-ID": {"type": "string", "pattern": "^[0-9]{5}$"}
      },
      "additionalProperties": {"type": "string"}
    },
    "body": {
      "type": "object",
      "required": ["serviceCode", "merchantId"],
      "additionalProperties": false,
      "properties": {
        "originalReferenceNo": {"type": "string", "minLength": 1},
        "originalPartnerReferenceNo": {"type": "string", "minLength": 1, "maxLength": 64},
        "serviceCode": {"type": "string"},
        "merchantId": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    }
  },
  "$defs": {
    "mpm_timestamp": {
      "description": "yyyy-MM-ddTHH:mm:ss.SSS+HH:MM (section 1.3; numeric offset, no Z)",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}[+-][0-9]{2}:[0-9]{2}$"
    }
  }
}
